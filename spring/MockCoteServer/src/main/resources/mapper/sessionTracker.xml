<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper
	namespace="com.mockcote.MockCoteServer.model.mapper.SessionTrackerMapper">

	<insert id="insertSessionTrackers"
		parameterType="com.mockcote.MockCoteServer.dto.Session">
		INSERT INTO session_trackers (session_id, user_id, problem_id)
		VALUES
		<foreach collection="sessionParticipants" item="user"
			separator=",">
			<foreach collection="sessionProblems" item="problem"
				separator=",">
				(#{sessionId}, #{user.userId}, #{problem.problemId})
			</foreach>
		</foreach>
	</insert>

</mapper>